        "android": ["text"]
      },
      "iosIdentifier": "nested-label"
    },
    "status": {
      "labels": [
        "Notifications: off · Screen: overview",
        "Notifications: on · Screen: overview",
        "Notifications: on · Screen: details"
      ],
      "roles": {
        "ios": ["text"],
        "android": ["text"]
      },
      "iosIdentifier": "accessibility-state"
    },
    "name": {
      "labels": ["Name"],
      "roles": {
        "ios": ["text-field"],
        "android": ["text-field"]
      },
      "iosIdentifier": "name-field",
      "value": "Ada",
      "editable": true,
      "secure": false
    },
    "password": {
      "labels": ["Password"],
      "roles": {
        "ios": ["text-field"],
        "android": ["text-field"]
      },
      "iosIdentifier": "password-field",
      "value": null,
      "editable": true,
      "secure": true
    },
    "toggle": {
      "labels": ["Notifications"],
      "roles": {
        "ios": ["switch"],
        "android": ["switch"]
      },
      "iosIdentifier": "notifications-toggle",
      "androidClassContains": "switch"
