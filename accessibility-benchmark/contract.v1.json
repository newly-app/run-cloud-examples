    "navigate": {
      "labels": ["Open details", "Back to overview"],
      "roles": {
        "ios": ["button"],
        "android": ["button"]
      },
      "iosIdentifier": "navigate-button",
      "enabled": true
    }
  },
  "states": {
    "initial": {
      "nestedLabel": "Nested label: overview",
      "status": "Notifications: off · Screen: overview",
      "toggleChecked": false,
      "navigationLabel": "Open details"
    },
    "notificationsOn": {
      "nestedLabel": "Nested label: overview",
      "status": "Notifications: on · Screen: overview",
      "toggleChecked": true,
      "navigationLabel": "Open details"
    },
    "details": {
      "nestedLabel": "Nested label: details",
      "status": "Notifications: on · Screen: details",
      "toggleChecked": true,
      "navigationLabel": "Back to overview"
    }
