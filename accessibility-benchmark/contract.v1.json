{
  "schemaVersion": 1,
  "name": "run.cloud native accessibility benchmark",
  "source": {
    "license": "MIT",
    "ios": {
      "directory": "ios-app-screenshot",
      "language": "Swift",
      "artifact": "RunCloudProof.app.tar.gz"
    },
    "android": {
      "directory": "android-app-screenshot",
      "language": "Java",
      "artifact": "RunCloudProof.apk"
    }
  },
  "forbiddenAccessibleText": "runcloud-secret-42",
  "hierarchy": {
